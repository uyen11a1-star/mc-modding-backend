# Random long string used to sign JWTs and session cookies.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-string

# SQLite by default. For production on Railway/Render you can switch
# to a Postgres URL they provide, e.g. postgresql://user:pass@host/db
DATABASE_URL=sqlite:///./app.db

# Where the frontend (index.html) is hosted. After login, the API
# redirects back here with a token.
FRONTEND_URL=https://uyen11a1-star.github.io/minecraft-modding-hub/

# --- Google OAuth ---
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: <YOUR_BACKEND_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub OAuth ---
# Create at https://github.com/settings/developers -> New OAuth App
# Authorization callback URL must be: <YOUR_BACKEND_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
